if [[ -n "${_commit}" ]]; then
  if [[ ! ${_commit} =~ ^[0-9a-f]{40}$ ]]; then
    printf '%s\n' '_commit must be a full lowercase 40-character source SHA.' >&2
    return 1
  fi
  _fragment="#commit=${_commit}"
else
  _fragment="#tag=mic-v${pkgver}"
fi
source=(
  "$pkgname::git+${_repo_url}${_fragment}"
  "ffmpeg-${_ffmpeg_version}-x86_64.tar.gz::https://github.com/LizardByte/build-deps/releases/download/v${_ffmpeg_version}/Linux-x86_64-ffmpeg.tar.gz"
)
sha256sums=(
  'SKIP'
  '496d2bbb674d01e6033e31b9dfc15cbc9dc1494e882a4505f6ab1e03f75b385c'
)
for _entry in "${_submodules[@]}"; do
  IFS='|' read -r _name _sha _url <<< "${_entry}"
  source+=("${_name}::git+${_url}#commit=${_sha}")
  sha256sums+=('SKIP')
done
unset _entry _name _sha _url

if [[ "${_support_headless_testing::1}" == "t" ]]; then
  optdepends+=(
    'xorg-server-xvfb: Virtual X server for headless testing'
  )
fi

# Ensure makedepends, checkdepends, optdepends are sorted
if [ -n "${makedepends+x}" ]; then
  mapfile -t tmp_array < <(printf '%s\n' "${makedepends[@]}" | sort)
  makedepends=("${tmp_array[@]}")
  unset tmp_array
fi

if [ -n "${optdepends+x}" ]; then
  mapfile -t tmp_array < <(printf '%s\n' "${optdepends[@]}" | sort)
  optdepends=("${tmp_array[@]}")
  unset tmp_array
fi

_prepare_submodules() {
    local _repo=$1 _key _path _url _sha _entry _name _cached_sha _cached_url _cache
    [[ -f ${_repo}/.gitmodules ]] || return 0
    while IFS= read -r _key; do
      _path=$(git -C "${_repo}" config -f .gitmodules --get "${_key}") || return 1
      _url=$(git -C "${_repo}" config -f .gitmodules --get "${_key%.path}.url") || return 1
      _sha=$(git -C "${_repo}" rev-parse "HEAD:${_path}") || return 1
      _cache=
      for _entry in "${_submodules[@]}"; do
        IFS='|' read -r _name _cached_sha _cached_url <<< "${_entry}"
        if [[ ${_url} == "${_cached_url}" && ${_sha} == "${_cached_sha}" ]]; then
          _cache="${srcdir}/${_name}"
          break
        fi
      done
      if [[ -z ${_cache} ]]; then
        printf 'Undeclared recursive gitlink: %s %s %s\n' "${_path}" "${_sha}" "${_url}" >&2
        return 1
      fi
      git -C "${_repo}" submodule init -- "${_path}" || return 1
      git -C "${_repo}" config "${_key%.path}.url" "${_cache}" || return 1
      # File transport is allowed only here, for already declared makepkg caches.
      # No remote fallback: all nested gitlinks must be available in those caches.
      git -C "${_repo}" -c protocol.file.allow=always submodule update \
        --init --no-fetch --checkout -- "${_path}" || return 1
      [[ $(git -C "${_repo}/${_path}" rev-parse HEAD) == "${_sha}" ]] || return 1
      _prepare_submodules "${_repo}/${_path}" || return 1
    done < <(git -C "${_repo}" config -f .gitmodules --name-only --get-regexp '^submodule\..*\.path$')
}

prepare() {
    _prepare_submodules "${srcdir}/${pkgname}" || return 1
    local _library
    for _library in avcodec swscale avutil cbs SvtAv1Enc x264 x265 hdr10plus; do
      if [[ ! -s ${srcdir}/ffmpeg/lib/lib${_library}.a ]]; then
        printf 'Pinned FFmpeg asset is missing lib%s.a\n' "${_library}" >&2
        return 1
      fi
    done
    [[ -s ${srcdir}/ffmpeg/include/libavcodec/avcodec.h ]] || return 1
    # npm ci in the existing CMake build consumes the committed lockfile unchanged.
}

build() {
    export BRANCH="mic"
    export BUILD_VERSION="${pkgver}"
    export COMMIT="$(git -C "$pkgname" rev-parse HEAD)"
    export TAG="mic-v${pkgver}"
    export CLONE_URL="${_repo_url}"

    export CC="gcc${_gcc_env_suffix}"
    export CXX="g++${_gcc_env_suffix}"

    export CFLAGS="${CFLAGS/-Werror=format-security/}"
    export CXXFLAGS="${CXXFLAGS/-Werror=format-security/}"

    export MAKEFLAGS="${MAKEFLAGS:--j$(nproc)}"

    local _cmake_options=(
      -S "$pkgname"
      -B cmake-build-release
      -Wno-dev
      -D BUILD_DOCS=OFF
      -D BUILD_WERROR=ON
      -D CMAKE_INSTALL_PREFIX=/usr
      -D SUNSHINE_EXECUTABLE_PATH=/usr/bin/sunshine
      -D SUNSHINE_ASSETS_DIR="share/sunshine"
      -D SUNSHINE_PUBLISHER_NAME='Sunshine Mic'
      -D SUNSHINE_PUBLISHER_WEBSITE="${_project_url}"
      -D SUNSHINE_PUBLISHER_ISSUE_URL="${_project_url}/issues"
      -D FFMPEG_PREPARED_BINARIES="${srcdir}/ffmpeg"
      -D SUNSHINE_ENABLE_CUDA=ON
      -D CUDA_FAIL_ON_MISSING=ON
      -D GLAD_SKIP_PIP_INSTALL=ON
      -D Python_EXECUTABLE=/usr/bin/python
    )

    # CUDA is an explicit build dependency, not an optional host-detected feature.
    # Preserve Arch's versioned host-compiler compatibility when cuda requires it.
    local _cuda_gcc_version
    _cuda_gcc_version="$(LC_ALL=C pacman -Qi cuda | grep -Pom1 '^Depends On\s*:.*\bgcc\K[0-9]+\b' || true)"
    export CUDA_PATH=/opt/cuda
    if [[ -n ${_cuda_gcc_version} ]]; then
      export NVCC_CCBIN="/usr/bin/g++-${_cuda_gcc_version}"
    else
      export NVCC_CCBIN="/usr/bin/g++${_gcc_env_suffix}"
    fi
    [[ -x ${CUDA_PATH}/bin/nvcc && -x ${NVCC_CCBIN} ]] || return 1

    if [[ "${_run_unit_tests::1}" != "t" ]]; then
      _cmake_options+=(-DBUILD_TESTS=OFF)
    fi

    local -a _appstreamcli_arguments=()
    if [[ -z "${GITHUB_ACTIONS:-}" ]]; then
      _appstreamcli_arguments=(--no-net)
    fi

    cmake "${_cmake_options[@]}"

    appstreamcli validate "${_appstreamcli_arguments[@]}" "cmake-build-release/dev.lizardbyte.app.Sunshine.metainfo.xml"
    appstream-util validate "cmake-build-release/dev.lizardbyte.app.Sunshine.metainfo.xml"
    desktop-file-validate "cmake-build-release/dev.lizardbyte.app.Sunshine.desktop"
    desktop-file-validate "cmake-build-release/dev.lizardbyte.app.Sunshine.terminal.desktop"

    cmake --build cmake-build-release
}

check() {
    if [[ "${_run_unit_tests::1}" == "t" ]]; then
      export CC="gcc${_gcc_env_suffix}"
      export CXX="g++${_gcc_env_suffix}"

      cd "${srcdir}/cmake-build-release/tests"
      # Do not silently upload misleading coverage if the gcov runtime cannot
      # write profile data, such as when its version differs from the compiler.
      GCOV_EXIT_AT_ERROR=1 ./test_sunshine --gtest_color=yes --gtest_output=xml:test_results.xml

      # Generate coverage report
      # Run gcovr from the build directory (where all .gcda/.gcno files are)
      cd "${srcdir}/cmake-build-release"

      # Dynamically find the gcov executable from the selected compiler.
      # This ensures we use the same gcov version that produced the .gcno files.
      local gcov_path
      local gcc_lib_dir

      gcc_lib_dir="$("$CC" -print-libgcc-file-name)"
      gcc_lib_dir="${gcc_lib_dir%/*}"
      gcov_path="${gcc_lib_dir}/gcov"

      if [ ! -x "$gcov_path" ]; then
        gcov_path="$("$CC" -print-prog-name=gcov)"
      fi

      if [ -n "$gcov_path" ] && command -v "$gcov_path" > /dev/null 2>&1; then
        gcov_path="$(command -v "$gcov_path")"
      else
        gcov_path="$(command -v "gcov${_gcc_env_suffix}" || command -v gcov || true)"
      fi

      if [ -z "$gcov_path" ]; then
        echo "Unable to find gcov for ${CC}" >&2
        return 1
      fi

      echo "Using gcov at: $gcov_path"

      # Use the actual relative path to the source directory
      # From ${srcdir}/cmake-build-release, source is at ../${pkgname}/src.
      gcovr --gcov-executable "$gcov_path" . -r "../${pkgname}/src" \
        --exclude-noncode-lines \
        --exclude-throw-branches \
        --exclude-unreachable-branches \
        --verbose \
        --xml-pretty \
        -o coverage.xml

      # Post-process the coverage XML to strip the absolute path and show only 'src'
      sed -i "s|${srcdir}/${pkgname}/src|src|g" coverage.xml
    fi

    cd "${srcdir}/cmake-build-release"
    env -i HOME="${srcdir}/version-home" XDG_CONFIG_HOME="${srcdir}/version-home/.config" \
      PATH=/usr/bin:/bin LANG=C.UTF-8 ./sunshine \
      "file_apps=${srcdir}/${pkgname}/src_assets/linux/assets/apps.json" --version
}

package() {
    export MAKEFLAGS="${MAKEFLAGS:--j$(nproc)}"
    DESTDIR="$pkgdir" cmake --install cmake-build-release

    local _guard="${srcdir}/${pkgname}/packaging/omarchy/mic-guard"
    install -Dm755 "${_guard}/sunshine-mic" "${pkgdir}/usr/bin/sunshine-mic"
    install -Dm755 "${_guard}/guard" "${pkgdir}/usr/lib/sunshine-mic/guard"
    install -Dm644 "${_guard}/guardlib.py" "${pkgdir}/usr/lib/sunshine-mic/guardlib.py"
    install -Dm644 "${_guard}/sunshine-mic-guard.service" \
      "${pkgdir}/usr/lib/systemd/system/sunshine-mic-guard.service"

    # Hash final installed bytes. makepkg must not strip them again afterward.
    strip --strip-unneeded "${pkgdir}/usr/bin/sunshine"
    local _binary_sha
    _binary_sha=$(sha256sum "${pkgdir}/usr/bin/sunshine") || return 1
    _binary_sha=${_binary_sha%% *}
    install -dm755 "${pkgdir}/usr/share/sunshine-mic"
    printf '{"schema":1,"sha256":"%s","stream_mic":false,"mic_default_source":false}\n' \
      "${_binary_sha}" > "${pkgdir}/usr/share/sunshine-mic/disabled-defaults.json"
    chmod 644 "${pkgdir}/usr/share/sunshine-mic/disabled-defaults.json"

    local _licenses="${pkgdir}/usr/share/licenses/${pkgname}" _notice
    install -Dm644 "${srcdir}/${pkgname}/LICENSE" "${_licenses}/LICENSE"
    install -Dm644 "${srcdir}/${pkgname}/NOTICE" "${_licenses}/NOTICE"
    # Preserve notices with their source-relative paths; do not relicense them.
    cd "${srcdir}/${pkgname}"
    while IFS= read -r -d '' _notice; do
      install -Dm644 "${_notice}" "${_licenses}/${_notice}"
    done < <(find third-party -type f \( -iname 'license*' -o -iname 'licence*' \
      -o -iname 'copying*' -o -iname 'copyright*' -o -iname 'notice*' \) -print0)
    # Include notices for the web bundle and CMake's exact-version source downloads.
    while IFS= read -r -d '' _notice; do
      install -Dm644 "${_notice}" "${_licenses}/${_notice}"
    done < <(find node_modules -type f \( -iname 'license*' -o -iname 'licence*' \
      -o -iname 'copying*' -o -iname 'copyright*' -o -iname 'notice*' \) -print0)
    cd "${srcdir}/cmake-build-release"
    local _dependency
    for _dependency in _deps/*-src; do
      [[ -d ${_dependency} ]] || continue
      while IFS= read -r -d '' _notice; do
        install -Dm644 "${_notice}" "${_licenses}/cmake-dependencies/${_notice#_deps/}"
      done < <(find "${_dependency}" -type f \( -iname 'license*' -o -iname 'licence*' \
        -o -iname 'copying*' -o -iname 'copyright*' -o -iname 'notice*' \) -print0)
    done
}
